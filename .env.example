# Copy to .env (never commit it) and fill in.

# Strong random password for the database, e.g.: openssl rand -base64 32
POSTGRES_PASSWORD=

# Your domain, without https:// (Caddy gets the certificate for it).
SITE_DOMAIN=sarojcouture.com

# Full public URL of the site — used for the sitemap, canonical URLs and OG tags.
NEXT_PUBLIC_SITE_URL=https://sarojcouture.com
